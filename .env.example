# ─── Modelo de variáveis de ambiente ─────────────────────────
# Copie este arquivo para ".env" e preencha com valores reais.
# O arquivo ".env" está no .gitignore e NUNCA deve ir para o GitHub.

# String de conexão do MongoDB Atlas.
# Pegue em: Atlas > Database > Connect > Drivers.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nome do banco de dados que a aplicação vai usar.
MONGODB_DB=graphrag

# Chave da API da Anthropic (usada nas etapas de IA / GraphRAG).
# Pegue em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave da Voyage AI para gerar embeddings (busca vetorial).
# Pegue em: https://dashboard.voyageai.com/
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Geração da resposta (Claude) — opcionais, têm padrão no código ───
# Modelo usado para redigir a resposta. Sonnet é bem mais rápido que Opus e
# ótimo para respostas curtas ancoradas nos fatos do grafo.
CLAUDE_MODEL=claude-sonnet-5
# "thinking": false = escreve direto (primeira palavra aparece antes, melhor
# na demo); true = raciocina antes (um pouco mais lento para começar).
CLAUDE_THINKING=false
# Teto do tamanho da resposta.
CLAUDE_MAX_TOKENS=1500

# ─── Pré-aquecimento do cache no startup — opcional, padrão ligado ───
# true = ao subir o backend, aquece as perguntas fixas da demo em segundo plano
# (a 1ª pergunta já responde rápido). Desligue em dev para poupar cota da Voyage.
WARMUP_CACHE_ON_STARTUP=true
